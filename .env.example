# ============================================================
# 飞书成员账号开通/回收机器人 —— 配置模板
# 复制本文件为 .env 并填写真实值：  cp .env.example .env  (Windows: copy .env.example .env)
# ============================================================

# ---------- 飞书自建应用凭证（开发者后台 https://open.feishu.cn/app ） ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 事件订阅里的 验证令牌 Verification Token（可选，若开启才填）
FEISHU_VERIFICATION_TOKEN=
# 事件订阅里的 Encrypt Key（可选，若开启加密才填）
FEISHU_ENCRYPT_KEY=

# ---------- 服务监听 ----------
HOST=0.0.0.0
PORT=8000

# 本地数据目录（审批单、审计日志保存在这里）
DATA_DIR=data

# ---------- 通讯录默认值 ----------
# 开通账号时用户归属的默认部门 open_department_id（形如 od-xxxxxxxx）。
# 获取方式：管理后台 -> 成员与部门 -> 点开目标部门 -> 浏览器地址栏/详情里找 od- 开头的 ID。
# 也可在命令里用 部门=od-xxxx 临时覆盖。
DEFAULT_DEPARTMENT_OPEN_ID=od-xxxxxxxxxxxx

# 员工类型：1 正式 2 实习生 3 外包 4 劳务 5 顾问（或贵司自定义枚举值）
DEFAULT_EMPLOYEE_TYPE=1

# 彻底删除(离职)时，成员名下文档/日程/群聊等资源转交给谁（open_id，可选）。
# 留空则由飞书默认转给其直属上级。
DELETE_RESOURCE_ACCEPTOR_OPEN_ID=

# ---------- 权限（重要） ----------
# 允许使用本机器人的操作员 open_id，多个用英文逗号分隔。
# 先让本人给机器人发“我的ID”，把返回的 ou_xxx 填到这里。留空=任何人禁用（默认安全）。
OPERATOR_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 审批人 open_id（仅审批模式下生效），多个用英文逗号分隔。
APPROVER_OPEN_IDS=

# ---------- 执行模式：direct=收到指令直接执行  approval=先发卡片给审批人，同意后执行 ----------
PROVISION_MODE=direct
FREEZE_MODE=direct
UNFREEZE_MODE=direct
DELETE_MODE=approval

# 审批单有效时长（分钟），超时未审批自动作废
APPROVAL_TTL_MINUTES=1440
